---
import BaseLayout from "../layouts/BaseLayout.astro";
import ArticleCard from "../components/ArticleCard.astro";
import { sections } from "../data/sections";
import { getFeaturedArticles, getPublishedArticles } from "../lib/articles";

const featured = await getFeaturedArticles();
const articles = await getPublishedArticles();
const heroSlides = (featured.length > 1 ? featured : articles.slice(0, 5)).slice(0, 6);
const carouselSlides =
  heroSlides.length > 1
    ? [heroSlides[heroSlides.length - 1], ...heroSlides, heroSlides[0]]
    : heroSlides;
const hero = heroSlides[0] ?? articles[0];
const latest = articles.filter((article) => article.id !== hero?.id).slice(0, 6);
---

<BaseLayout>
  <section class="hero" data-hero-carousel>
    {heroSlides.length > 0 && (
      <div class="hero-feature">
        <div
          class="hero-track"
          data-hero-track
          style={`--slide-count: ${carouselSlides.length}; --track-index: ${heroSlides.length > 1 ? 1 : 0};`}
        >
          {carouselSlides.map((slide, index) => (
            <a
              class="hero-slide"
              href={`/articles/${slide.slug}/`}
              data-hero-slide
              aria-hidden={heroSlides.length > 1 ? (index === 1 ? "false" : "true") : "false"}
            >
              {slide.data.cover && <img src={slide.data.cover} alt={slide.data.coverAlt ?? ""} />}
              <div class="hero-feature-caption">
                <span>{slide.data.section.replaceAll("-", " ")}</span>
                <strong>{slide.data.title}</strong>
              </div>
            </a>
          ))}
        </div>

        {heroSlides.length > 1 && (
          <>
            <div class="hero-controls" aria-label="Navigation du hero">
              <button type="button" data-hero-prev aria-label="Article précédent">
                <span aria-hidden="true">‹</span>
              </button>
              <button type="button" data-hero-next aria-label="Article suivant">
                <span aria-hidden="true">›</span>
              </button>
            </div>
            <div class="hero-dots" aria-label="Slides du hero">
              {heroSlides.map((slide, index) => (
                <button
                  type="button"
                  class:list={{ "is-active": index === 0 }}
                  data-hero-dot={index}
                  aria-label={`Afficher ${slide.data.title}`}
                />
              ))}
            </div>
          </>
        )}
      </div>
    )}
  </section>

  <section class="section-band">
    <div class="section-heading">
      <p class="eyebrow">Rubriques</p>
      <h2>Rubriques simples, publication directe.</h2>
    </div>
    <div class="section-grid">
      {sections.map((section) => (
        <a class="section-link" href={`/sections/${section.slug}/`}>
          <h3>{section.title}</h3>
          <p>{section.description}</p>
        </a>
      ))}
    </div>
  </section>

  <section class="section-band">
    <div class="section-heading">
      <p class="eyebrow">Dernieres publications</p>
      <h2>Selection editoriale</h2>
    </div>
    <div class="article-list">
      {latest.map((article) => (
        <ArticleCard
          title={article.data.title}
          description={article.data.description}
          href={`/articles/${article.slug}/`}
          date={article.data.date}
          section={article.data.section}
          tags={article.data.tags}
          cover={article.data.cover}
          coverAlt={article.data.coverAlt}
        />
      ))}
    </div>
  </section>
</BaseLayout>

<script>
  const root = document.querySelector("[data-hero-carousel]");

  if (root) {
    const track = root.querySelector("[data-hero-track]");
    const trackElement = track instanceof HTMLElement ? track : null;
    const slides = Array.from(root.querySelectorAll("[data-hero-slide]"));
    const dots = Array.from(root.querySelectorAll("[data-hero-dot]"));
    const previous = root.querySelector("[data-hero-prev]");
    const next = root.querySelector("[data-hero-next]");
    const hasLoopClones = slides.length > dots.length;
    const realSlideCount = dots.length || slides.length;
    let activeIndex = 0;
    let trackIndex = hasLoopClones ? 1 : 0;
    let intervalId;
    let isAnimating = false;

    const setTrackIndex = (nextTrackIndex, animate = true) => {
      if (!trackElement) return;
      trackIndex = nextTrackIndex;
      trackElement.classList.toggle("is-animating", animate);
      trackElement.style.setProperty("--track-index", String(trackIndex));
    };

    const syncState = () => {
      activeIndex = ((trackIndex - (hasLoopClones ? 1 : 0)) % realSlideCount + realSlideCount) % realSlideCount;

      slides.forEach((slide, index) => {
        const realIndex = hasLoopClones
          ? (index === 0 ? realSlideCount - 1 : index === slides.length - 1 ? 0 : index - 1)
          : index;
        slide.setAttribute("aria-hidden", realIndex === activeIndex ? "false" : "true");
      });

      dots.forEach((dot, index) => {
        dot.classList.toggle("is-active", index === activeIndex);
      });
    };

    const moveToTrackIndex = (nextTrackIndex) => {
      if (!slides.length || isAnimating) return;
      isAnimating = true;
      setTrackIndex(nextTrackIndex, true);
      syncState();
    };

    const restartAutoplay = () => {
      window.clearInterval(intervalId);
      intervalId = window.setInterval(() => moveToTrackIndex(trackIndex + 1), 9000);
    };

    trackElement?.addEventListener("transitionend", () => {
      if (!hasLoopClones) {
        isAnimating = false;
        return;
      }

      if (trackIndex === 0) {
        setTrackIndex(realSlideCount, false);
      } else if (trackIndex === slides.length - 1) {
        setTrackIndex(1, false);
      }

      syncState();
      window.requestAnimationFrame(() => {
        trackElement?.classList.add("is-animating");
        isAnimating = false;
      });
    });

    previous?.addEventListener("click", () => {
      moveToTrackIndex(trackIndex - 1);
      restartAutoplay();
    });

    next?.addEventListener("click", () => {
      moveToTrackIndex(trackIndex + 1);
      restartAutoplay();
    });

    dots.forEach((dot, index) => {
      dot.addEventListener("click", () => {
        moveToTrackIndex(hasLoopClones ? index + 1 : index);
        restartAutoplay();
      });
    });

    syncState();
    restartAutoplay();
  }
</script>
